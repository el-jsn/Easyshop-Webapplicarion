@model EasyShop.Models.Order

@{
    ViewData["Title"] = "Your Shopping Cart";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var isCustomer = User.IsInRole("Customer");
}

<div class="container">
    <h1 class="mt-4 mb-4">Your Shopping Cart</h1>

    <div class="row mt-2 mb-3">
        <div class="col">
            <a asp-action="Index" asp-controller="Products" class="btn btn-secondary">Continue Shopping</a>
        </div>
    </div>

    @if (isCustomer)
    {
        @if (Model == null)
        {
            <div class="alert alert-info mt-2 mb-2">
                You haven't placed an order yet. Add a product to view your order.
            </div>
        }
        else
        {
            <div class="card">
                <div class="card-header">
                    Order Summary
                </div>
                <div class="card-body">
                    @if (Model.Details != null && Model.Details.Count > 0)
                    {
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Product Name</th>
                                    <th>Quantity</th>
                                    <th>Single Value</th>
                                    <th>Total Value</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Details)
                                {
                                    <tr>
                                        @if (item.product != null)
                                        {
                                            <td>@item.product.Name</td>
                                        }
                                        else
                                        {
                                            <td></td>
                                        }
                                        <td>@item.Quantity</td>
                                        <td>@item.SingleValue</td>
                                        <td>@item.TotalValue</td>
                                        <td><a asp-action="Delete" asp-route-id="@item.Id" class="text-danger">Remove</a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        <div class="card mt-4">
                            <div class="card-body">
                                <form id="payment-form">
                                    <div id="card-element"></div>
                                    <button id="submit" class="btn btn-success mt-2">Proceed to Payment</button>
                                </form>
                            </div>
                        </div>

                        <script src="https://js.stripe.com/v3/"></script>

                        <script>
                            var stripe = Stripe('pk_test_51NeqdNHN7kOD3K4h1ss1T5eRuj8ZLzxQH9TA84t8rosSls73VbzDJ5s5t5CBHZrlgJ8iuRk3QnR0Zeoh1QEVjiXm00ioNSlhRW');
                            var elements = stripe.elements();

                            var cardElement = elements.create('card');
                            cardElement.mount('#card-element');

                            var form = document.getElementById('payment-form');

                            form.addEventListener('submit', function (event) {
                                event.preventDefault();

                                document.getElementById('submit').disabled = true;

                                stripe.confirmCardPayment('@ViewBag.ClientSecret', {
                                    payment_method: {
                                        card: cardElement
                                    }
                                }).then(function (result) {
                                    if (result.error) {

                                        document.getElementById('submit').disabled = false;
                                    } else {
                   ns
                                        window.location.href = '@Url.Action("ThankYou", "Order")';
                                    }
                                });
                            });
                        </script>


                    }
                    else
                    {
                        <p>This order doesn't have any products.</p>
                    }
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-warning mt-2 mb-2">
            This section is only for registered users. Please log in to place an order.
        </div>
    }
</div>
